// Firebase 보안 규칙 버전 2 선언 (최신 구문 및 향상된 보안 검증 기능 지원)
rules_version = '2';

// Google Cloud Firestore 데이터베이스 서비스를 위한 보안 규칙 블록 정의
service cloud.firestore {
  
  // 현재 프로젝트의 기본 데이터베이스 내 모든 문서 루트 경로 매칭
  match /databases/{database}/documents {
    
    // --------------------------------------------------------------------------
    // 🏺 아고라 도편(Ostrakon) 방명록 컬렉션 보안 규칙
    // 경로: /ostraka/{문서ID}
    // --------------------------------------------------------------------------
    match /ostraka/{ostrakonId} {
      
      // [1] 읽기(조회) 권한:
      //     - 로그인 여부와 관계없이 전 세계 모든 방문자가 광장의 도편을 자유롭게 읽을 수 있도록 허용합니다.
      allow read: if true;

      // [2] 쓰기(새 도편 등록) 권한:
      //     - 클라이언트에서 새로운 도편 문서를 생성(add)할 때 아래의 모든 유효성 검증 조건을 100% 만족해야만 승인합니다.
      allow create: if 
                    // ① 필드 화이트리스트 검증: 지정된 6개 필드 외에 악의적인 임의 필드 주입을 원천 차단
                    request.resource.data.keys().hasOnly(['author', 'badge', 'date', 'style', 'message', 'createdAt'])
                    
                    // ② 작성자명(author) 검증: 문자열 타입이어야 하며, 1자 이상 30자 이하로 제한 (대용량 텍스트 공격 방어)
                    && request.resource.data.author is string
                    && request.resource.data.author.size() > 0
                    && request.resource.data.author.size() <= 30
                    
                    // ③ 도편 본문(message) 검증: 문자열 타입이어야 하며, 1자 이상 300자 이하로 제한 (도배 및 스팸 방어)
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 300
                    
                    // ④ 테마 스타일(style) 검증: 3대 고대 그리스 지정 테마(테라코타, 파로스 대리석, 올림포스 황금판)만 허용
                    && request.resource.data.style in ['terracotta', 'paros', 'olympus'];

      // [3] 수정 및 삭제 권한 전면 차단:
      //     - 이미 광장에 새겨진 도편은 일반 웹 방문자가 임의로 변조하거나 삭제할 수 없습니다 (영구 불변성 보장).
      //     - 단, 부적절한 도편은 운영자가 Firebase 웹 콘솔(관리자 권한)에서 언제든 직접 삭제할 수 있습니다.
      allow update, delete: if false;
    }

    // --------------------------------------------------------------------------
    // 🛡️ 기본 거부 원칙 (Default Deny):
    // ostraka 컬렉션 외에 존재하거나 생성될 수 있는 모든 경로에 대한 비인가 읽기/쓰기를 전면 차단합니다.
    // --------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
